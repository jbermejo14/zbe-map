# Origen público del sitio, sin ruta ni barra final. Se usa en canonical, og:url, JSON-LD y sitemap.
# Por defecto: http://localhost:3000. En producción: https://ododex.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Identificador de editor de Google AdSense (ca-pub- y 16 dígitos). Opcional: sin él no se carga
# el script ni se muestra el botón "Configurar cookies".
NEXT_PUBLIC_ADSENSE_CLIENT=

# Tags de afiliación de los enlaces comerciales de las recomendaciones. Opcionales: sin ellos
# los enlaces van limpios y sin seguimiento.
NEXT_PUBLIC_AFFILIATE_CLICARS_TAG=
NEXT_PUBLIC_AFFILIATE_RENTING_TAG=
NEXT_PUBLIC_AFFILIATE_TASACION_TAG=
