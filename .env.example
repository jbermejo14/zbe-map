# URL canónica base del sitio web (para SEO, sitemap, canonical y OpenGraph)
NEXT_PUBLIC_SITE_URL=https://radar-zbe.es

# Parámetros y tags de afiliación comercial (opcionales; si no se configuran, los enlaces permanecen limpios y sin tracking)
AFFILIATE_CLICARS_TAG=
AFFILIATE_RENTING_TAG=
AFFILIATE_TASACION_TAG=

# Mapas: teselas y atribución. Si se dejan vacías se usan los basemaps de CARTO (sin clave).
# Límites de uso de CARTO: ver README (uso gratuito sujeto a sus términos; el uso comercial intensivo requiere plan propio).
NEXT_PUBLIC_MAP_TILE_URL_LIGHT=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
NEXT_PUBLIC_MAP_TILE_URL_DARK=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>
