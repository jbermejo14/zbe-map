datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Vehicle {
  id               String   @id @default(uuid())
  brand            String
  model            String
  version          String
  year             Int
  propulsionCode   String
  euroNorm         String
  dgtBadge         String   // CERO, ECO, C, B, SIN_ETIQUETA
  electricRangeKm  Int?
  co2Emissions     Float?
  powerKw          Float
  powerCv          Float
  bodyType         String   // Utilitario, Compacto, Berlina, SUV, Monovolumen, Deportivo
  wheelbaseMm      Int      // Batalla en mm
  registrationDate DateTime?
  slug             String   @unique
  createdAt        DateTime @default(now())

  @@index([brand, model])
  @@index([dgtBadge])
  @@index([bodyType])
}

model ZbeCity {
  id               String    @id
  slug             String    @unique
  name             String
  province         String
  region           String
  lat              Float
  lng              Float
  status           String    // activa, en_tramitacion
  fineAmount       Int       @default(200)
  schedule         String
  summary          String
  exemptions       String    // JSON string list of exemptions
  parkingCondition String?
  perimeterName    String?
  areaKm2          Float?
  polygon          String?   // JSON string de [lat, lng][]
  streets          String?   // JSON string de calles perimetrales
  geoJSON          String?   // JSON string de GeoJSON FeatureCollection
  rules            ZbeRule[]
  createdAt        DateTime  @default(now())
}

model ZbeRule {
  id           String   @id @default(uuid())
  cityId       String
  city         ZbeCity  @relation(fields: [cityId], references: [id], onDelete: Cascade)
  dgtBadge     String   // CERO, ECO, C, B, SIN_ETIQUETA
  accessStatus String   // allowed, restricted, banned
  reason       String

  @@unique([cityId, dgtBadge])
}
